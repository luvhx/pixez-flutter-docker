# Copy to .env and adjust as needed (docker compose reads it automatically).

# Host port for the web UI.
PIXEZ_PORT=7493

# Image tag (PIXEZ_TAG=sha-xxxxxxx to pin a build).
PIXEZ_TAG=latest

# Flutter SDK version used during the Docker build.
FLUTTER_VERSION=3.47.7

# Container time zone.
TZ=Asia/Shanghai

# Web login verification (HTTP Basic Auth).
# PIXEZ_AUTH_PASSWORD is REQUIRED by docker-compose; set a strong password.
# Leave it empty to start docker compose and see the same reminder.
PIXEZ_AUTH_USER=pixez
PIXEZ_AUTH_PASSWORD=
